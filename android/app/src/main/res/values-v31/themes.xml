<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: systemets startbild i sajtens mörka färg med den runda
         ikonen, samma som uppstarten (drawable/uppstart) som följer. -->
    <style name="Uppstart" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:statusBarColor">@color/natt</item>
        <item name="android:navigationBarColor">@color/natt</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/natt</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
