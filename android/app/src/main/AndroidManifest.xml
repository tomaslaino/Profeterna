<?xml version="1.0" encoding="utf-8"?>
<!-- Matchfixarna som app: sajten i användarens Chrome (Trusted Web Activity).
     LauncherActivity och de andra aktiviteterna kommer från Googles
     androidbrowserhelper; här står bara vad appen ska göra. Se README, Appen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Aviseringar från sajten (web push) visas som appens egna, om sajten
         någon gång skickar sådana. Android frågar först när sajten ber om det. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/appnamn"
        android:supportsRtl="false"
        android:manageSpaceActivity="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
        android:theme="@style/Uppstart">

        <!-- Sajten och appen hör ihop: matchfixarna.se/.well-known/assetlinks.json
             pekar tillbaka på appens nyckel. Först då visar Chrome sajten utan
             adressfält, och länkar till matchfixarna.se öppnas i appen. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <meta-data
            android:name="web_manifest_url"
            android:value="https://matchfixarna.se/manifest.webmanifest" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:alwaysRetainTaskState="true"
            android:exported="true"
            android:label="@string/appnamn">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://matchfixarna.se/" />

            <!-- Systemets list i sajtens mörka färg (theme-color #0e0d0b), i
                 ljust och mörkt läge. -->
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/natt" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
                android:resource="@color/natt" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/natt" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/natt" />
            <meta-data
                android:name="androix.browser.trusted.NAVIGATION_BAR_DIVIDER_COLOR"
                android:resource="@color/natt" />
            <meta-data
                android:name="androix.browser.trusted.NAVIGATION_BAR_DIVIDER_COLOR_DARK"
                android:resource="@color/natt" />

            <!-- Uppstarten: samma rund logo på samma mörka botten som systemets
                 startbild (values-v31), så att Chrome tar över utan att något
                 hoppar, och tonar bort när sajten har ritat sin första bild. -->
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/uppstart" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/natt" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="300" />
            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="se.matchfixarna.app.fileprovider" />

            <!-- Länkar och genvägar till en sida medan appen är öppen går dit i
                 samma fönster, i stället för att öppna ett till. -->
            <meta-data
                android:name="android.support.customtabs.trusted.LAUNCH_HANDLER_CLIENT_MODE"
                android:value="navigate-existing" />

            <!-- Utan Chrome (eller en annan webbläsare som kan TWA) visas sajten i
                 appens egen WebView. -->
            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="webview" />

            <!-- Dela en skärmbild av systemet (Svenska Spels app) till appen: den
                 skickas till matchfixarna.se/dela/, där sajten tar emot den och
                 läser den som Ladda upp system (public/dela/sw.js). -->
            <meta-data
                android:name="android.support.customtabs.trusted.METADATA_SHARE_TARGET"
                android:value="@string/dela" />

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/genvagar" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="matchfixarna.se" />
            </intent-filter>

            <intent-filter android:label="@string/dela_etikett">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="@string/dela_etikett">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.customtabs.trusted.MANAGE_SPACE_URL"
                android:value="https://matchfixarna.se/" />
        </activity>

        <activity
            android:name="com.google.androidbrowserhelper.trusted.FocusActivity"
            android:exported="false" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Uppstart" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="se.matchfixarna.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filvagar" />
        </provider>

        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
